# ---------------------------------------------------------------------------
# Fangbuch-Backend – Beispielkonfiguration. Kopieren nach backend/.env
# Geheimnisse gehören NUR in diese Datei bzw. in die Umgebungsvariablen des Servers.
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=8787
PUBLIC_BASE_URL=http://localhost:8787
DATABASE_URL=postgres://postgres@localhost:5433/fvw_dev

# mindestens 32 Zeichen, z. B.: openssl rand -base64 48
BETTER_AUTH_SECRET=bitte-ersetzen-durch-einen-zufaelligen-schluessel-mit-48-zeichen
# Ed25519-Schlüssel für Patent-Ausweise (QR). Erzeugen: npm run keygen -w @fvw/backend
CREDENTIAL_SIGNING_KEY=

# Sitzungsdauer (offener Punkt O9; AD nennt 6–12 Monate als Beispiel)
SESSION_DAYS=180
STORAGE_DIR=./storage

# Demo-Modus: Mock-Integrationen, Demo-Code beim Login sichtbar. In Produktion nicht erlaubt.
DEMO_MODE=true
ADMIN_BOOTSTRAP_EMAILS=
CORS_ORIGINS=*
JOBS_ENABLED=true

# Fairgate Standard API (FSA) – off | demo | live
FAIRGATE_MODE=demo
FAIRGATE_BASE_URL=https://fsa-test.fairgate.ch
FAIRGATE_TOKEN=
FAIRGATE_PUBLIC_KEY=
# Pfad des Kontakt-Endpunkts laut FSA-OpenAPI-Doku (passwortgeschützt, nicht verifiziert)
FAIRGATE_CONTACTS_PATH=
# JSON-Zuordnung der Felder, z. B. {"id":"id","memberNo":"memberNumber","email":"primaryEmail","status":"membershipStatus","groups":"groups"}
FAIRGATE_FIELD_MAP=

# Eventfrog Organizer API (Read) – off | demo | live
EVENTFROG_MODE=demo
EVENTFROG_BASE_URL=https://api.eventfrog.net
EVENTFROG_API_KEY=
EVENTFROG_ORDERS_PATH=
EVENTFROG_FIELD_MAP=

# E-Mail: draft (nur Postausgang, kein Versand) | smtp
MAIL_MODE=draft
SMTP_URL=
MAIL_FROM=Fischereiverein Werdenberg <noreply@example.invalid>

# Push: off | draft | expo
PUSH_MODE=draft
EXPO_ACCESS_TOKEN=

# Vereinswebseite (Termine): off | demo | ical | rss | html
WEBSITE_MODE=demo
WEBSITE_FEED_URL=

# Google My Maps Aktualitätsprüfung: live | file | off
MYMAPS_MODE=live
MYMAPS_FILE_DIR=
